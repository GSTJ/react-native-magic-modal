{
  "name": "@magic-modal/docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build && node scripts/write-legacy-redirects.mjs && node scripts/check-artifact.mjs",
    "dev": "next dev",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint --report-unused-disable-directives",
    "start": "serve out",
    "test": "node --test test/*.test.mjs",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "fumadocs-core": "16.12.1",
    "fumadocs-mdx": "15.2.0",
    "fumadocs-typescript": "5.3.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.12.1",
    "lucide-react": "^1.25.0",
    "magic-docs": "1.0.0",
    "next": "16.2.12",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "magic-oxfmt-config": "^1.2.0",
    "magic-oxlint-config": "^1.2.0",
    "magic-tsconfig": "^1.2.0",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "postcss": "^8.5.21",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2"
  }
}
