{
  "name": "react-native-magic-modal",
  "version": "9.0.0",
  "description": "A magic modal that can be used imperatively from anywhere! 🦄",
  "keywords": [
    "android",
    "ios",
    "modal",
    "react-native"
  ],
  "homepage": "https://github.com/GSTJ/react-native-magic-modal#readme",
  "bugs": {
    "url": "https://github.com/GSTJ/react-native-magic-modal/issues"
  },
  "license": "MIT",
  "author": "Gabriel Taveira <gabrielstaveira@gmail.com> (https://github.com/GSTJ)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GSTJ/react-native-magic-modal.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bunchee",
    "lint": "oxlint --report-unused-disable-directives",
    "lint:fix": "oxlint --report-unused-disable-directives --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "copy:readme": "shx cp ../../README.md ./README.md",
    "docs": "typedoc --excludeInternal --out docs ./src/index.ts",
    "test": "jest",
    "release": "release-it --ci"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.0",
    "@testing-library/react-native": "^13.3.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.14",
    "bunchee": "^6.0.3",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.0",
    "jest-junit": "^17.0.0",
    "magic-oxfmt-config": "^1.2.0",
    "magic-oxlint-config": "^1.2.0",
    "magic-tsconfig": "^1.2.0",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "pod-install": "^1.0.0",
    "react-native": "0.83.6",
    "react-test-renderer": "19.2.0",
    "release-it": "^21.0.0",
    "shx": "^0.4.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typedoc": "^0.28.0",
    "typescript": "^7.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.81.0",
    "react-native-gesture-handler": ">=2.20.0",
    "react-native-reanimated": ">=4.0.0",
    "react-native-worklets": ">=0.5.0"
  },
  "peerDependenciesMeta": {
    "react-native-worklets": {
      "optional": true
    }
  }
}
