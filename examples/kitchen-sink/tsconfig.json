{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["expo/tsconfig.base", "magic-tsconfig/base.json"],
  "compilerOptions": {
    "jsx": "react-native",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "magic-modal": ["../../packages/modal/src/index.react-native.ts"],
      "magic-modal/*": ["../../packages/modal/src/*"]
    }
  },
  "include": ["."],
  "exclude": ["node_modules", "android", "ios", "dist"]
}
